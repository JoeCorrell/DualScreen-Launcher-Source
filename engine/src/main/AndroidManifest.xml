<?xml version="1.0" encoding="utf-8"?>
<!--
    The engine's own manifest contributions.

    Only what the emulation stack itself needs. Activities, the launcher intent
    filter and the file provider belong to `:app`, which owns the interface.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
      Read-only, for the container desktop's tray. A normal permission at the
      target SDK this app is pinned to, so it is granted at install and never
      prompts; the tray only ever asks the adapter whether it is on.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
        The container filesystem is unpacked into external storage so a user can
        back it up and so exported presets and control profiles are reachable
        from a file manager. `MANAGE_EXTERNAL_STORAGE` is what makes that
        possible on API 30+; below that the legacy pair applies, which is one of
        the reasons targetSdk is pinned at 28.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!--
        A Wine session is a tree of native processes the platform cannot see, so
        without a foreground service holding the process up they are reaped as
        soon as the activity stops — which on a two-screen device happens as
        soon as an app covers the panel the session was started from.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name="com.wemu.engine.services.NotificationService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a running Windows container alive while its window is not in the foreground." />
        </service>

        <!--
            Exposes the container filesystem to the system file picker, so a
            user can copy a game into a container without the app having to
            reimplement a file manager.
        -->
        <provider
            android:name="com.wemu.engine.core.WemuFilesProvider"
            android:authorities="${applicationId}.core.WemuFilesProvider"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            tools:ignore="ExportedContentProvider">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>

<resources>
    <style name="Theme.DualScreenLauncher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/launcher_background</item>
        <item name="android:colorAccent">@color/launcher_accent</item>
    </style>
    <style name="Theme.DualScreenLauncher.Fullscreen" parent="Theme.DualScreenLauncher">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>

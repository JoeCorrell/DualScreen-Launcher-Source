; The surface a dxgi.dll is expected to have.
;
; Exported undecorated. The loader resolves d3d11.dll's import of
; CreateDXGIFactory2 by name, and the game resolves CreateDXGIFactory through
; GetProcAddress; a stdcall suffix would make both invisible and the proxy would
; silently never be used.
LIBRARY dxgi
EXPORTS
    CreateDXGIFactory
    CreateDXGIFactory1
    CreateDXGIFactory2
    DXGIGetDebugInterface1
    DXGIDeclareAdapterRemovalSupport
    DXGID3D10CreateDevice
    DXGID3D10CreateLayeredDevice
    DXGID3D10GetLayeredDeviceSize
    DXGID3D10RegisterLayers

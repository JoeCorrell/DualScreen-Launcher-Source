LIBRARY dxgi
EXPORTS
  ; Match the real Windows DXGI ordinals.  The previous table placed our
  ; private bridge exports on ordinals 10-16, which are occupied by the real
  ; CreateDXGIFactory/D3D10 entry points.  An overlay importing DXGI by ordinal
  ; could therefore jump into an unrelated SDS function and terminate Skyrim.
  CreateDXGIFactory @10
  CreateDXGIFactory1 @11
  CreateDXGIFactory2 @12
  DXGID3D10CreateDevice @13
  DXGID3D10CreateLayeredDevice @14
  DXGID3D10GetLayeredDeviceSize @15
  DXGID3D10RegisterLayers @16
  DXGIDeclareAdapterRemovalSupport @17
  DXGIDisableVBlankVirtualization @18
  DXGIGetDebugInterface1 @19
  DXGIReportAdapterConfiguration @20

  ; Keep the private ABI well outside the system export range.  These exports
  ; are normally resolved by name; explicit private ordinals simply prevent
  ; the linker from filling holes in DXGI's official table.
  SDS_SubmitSnapshot @1001
  SDS_PollCommand @1002
  SDS_EnableRenderer @1003
  SDS_SubmitItemPreview @1004
  SDS_GetCharacterPreviewSurface @1005
  SDS_SetCharacterPreviewReady @1006
  SDS_SubmitCharacterPreview @1007
  SDS_SubmitMapPreview @1008
  SDS_HasPendingCommand @1009
  SDS_PollCommandSized @1010

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>StardewDualScreen.Native</AssemblyName>
    <RootNamespace>StardewSecondScreen</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <GameReferenceDirectory Condition="'$(GameReferenceDirectory)' == ''">../../../.work/stardew-native/device-original</GameReferenceDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuse the proven, bounded WebSocket transport from the original UI.
         This is compiled into the patched game assembly; it is not a SMAPI
         dependency and no loose mod files are needed at runtime. -->
    <Compile Include="..\StardewSecondScreen\Bridge.cs" Link="Bridge.cs" />
    <Compile Remove="NativePanelFeed.cs" />
    <Compile Remove="NativePanelRenderer.cs" />

    <Reference Include="Stardew Valley">
      <HintPath>$(GameReferenceDirectory)/Stardew Valley.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(GameReferenceDirectory)/MonoGame.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Netcode" Condition="Exists('$(GameReferenceDirectory)/Netcode.dll')">
      <HintPath>$(GameReferenceDirectory)/Netcode.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="StardewValley.GameData">
      <HintPath>$(GameReferenceDirectory)/StardewValley.GameData.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="xTile">
      <HintPath>$(GameReferenceDirectory)/xTile.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

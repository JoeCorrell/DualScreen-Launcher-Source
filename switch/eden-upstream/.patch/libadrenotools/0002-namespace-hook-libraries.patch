From: Dualscreen Launcher integration
Subject: [PATCH] namespace adrenotools helper libraries for embedded runtime

Dualscreen Launcher also embeds its PC runtime's copy of libadrenotools.
Give Eden's helpers distinct names so packaging and dynamic linking cannot
select the implementation from the wrong backend.

diff --git a/src/driver.cpp b/src/driver.cpp
--- a/src/driver.cpp
+++ b/src/driver.cpp
@@ -74 +74 @@
-    auto hookImpl{linkernsbypass_namespace_dlopen("libhook_impl.so", RTLD_NOW, hookNs)};
+    auto hookImpl{linkernsbypass_namespace_dlopen("libeden_hook_impl.so", RTLD_NOW, hookNs)};
@@ -98 +98 @@
-    if (!linkernsbypass_namespace_dlopen("libmain_hook.so", RTLD_GLOBAL, hookNs))
+    if (!linkernsbypass_namespace_dlopen("libeden_main_hook.so", RTLD_GLOBAL, hookNs))
diff --git a/src/hook/CMakeLists.txt b/src/hook/CMakeLists.txt
--- a/src/hook/CMakeLists.txt
+++ b/src/hook/CMakeLists.txt
@@ -1 +1,2 @@
 add_library(hook_impl SHARED hook_impl.cpp hook_impl.h hook_impl_params.h)
+set_target_properties(hook_impl PROPERTIES OUTPUT_NAME eden_hook_impl)
@@ -8 +9,2 @@
 add_library(main_hook SHARED main_hook.c)
+set_target_properties(main_hook PROPERTIES OUTPUT_NAME eden_main_hook)
@@ -15 +17,2 @@
 add_library(file_redirect_hook SHARED file_redirect_hook.c)
+set_target_properties(file_redirect_hook PROPERTIES OUTPUT_NAME eden_file_redirect_hook)
@@ -22 +25,2 @@
 add_library(gsl_alloc_hook SHARED gsl_alloc_hook.c)
+set_target_properties(gsl_alloc_hook PROPERTIES OUTPUT_NAME eden_gsl_alloc_hook)
diff --git a/src/hook/hook_impl.cpp b/src/hook/hook_impl.cpp
--- a/src/hook/hook_impl.cpp
+++ b/src/hook/hook_impl.cpp
@@ -76 +76 @@
-    auto hookImpl{linkernsbypass_namespace_dlopen("libhook_impl.so", RTLD_NOW, driverNs)};
+    auto hookImpl{linkernsbypass_namespace_dlopen("libeden_hook_impl.so", RTLD_NOW, driverNs)};
@@ -88 +88 @@
-        if (!linkernsbypass_namespace_dlopen("libfile_redirect_hook.so", RTLD_GLOBAL, driverNs)) {
+        if (!linkernsbypass_namespace_dlopen("libeden_file_redirect_hook.so", RTLD_GLOBAL, driverNs)) {
@@ -101 +101 @@
-        if (!linkernsbypass_namespace_dlopen("libgsl_alloc_hook.so", RTLD_GLOBAL, driverNs)) {
+        if (!linkernsbypass_namespace_dlopen("libeden_gsl_alloc_hook.so", RTLD_GLOBAL, driverNs)) {
